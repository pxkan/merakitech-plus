      "t": 3.6,
      "window": 0.9,
      "value": "bye"
    },
    {
      "kind": "view",
      "t": 5.5,
      "window": 1,
      "value": "main"
    },
    {
      "kind": "flag",
      "t": 8,
      "exists": false
    },
    {
      "kind": "sim_log",
      "assert": "no_writes_between",
      "t0": 1,
      "t1": 9,
      "except_subs": [
        0,
        1,
        112
      ]
    }
  ]
